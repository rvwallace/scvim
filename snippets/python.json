{
  "PEP 723 Script (Base)": {
    "prefix": "pep723",
    "body": [
      "#!/usr/bin/env -S uv run --script",
      "# /// script",
      "# requires-python = \">=3.12\"",
      "# dependencies = [",
      "#     \"${1:requests}\",",
      "# ]",
      "# bin-name = \"${2:script-name}\"",
      "# ///",
      "from __future__ import annotations",
      "",
      "import sys",
      "",
      "",
      "def main() -> int:",
      "    ${0:print(\"Hello from uv script!\")}",
      "    return 0",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    sys.exit(main())"
    ],
    "description": "Complete PEP 723 standalone script with uv runner"
  },
  "PEP 723 Typer + Rich CLI (Annotated)": {
    "prefix": "pep723-typer",
    "body": [
      "#!/usr/bin/env -S uv run --script",
      "# /// script",
      "# requires-python = \">=3.12\"",
      "# dependencies = [",
      "#     \"rich\",",
      "#     \"typer\",",
      "# ]",
      "# bin-name = \"${1:tool-name}\"",
      "# ///",
      "from __future__ import annotations",
      "",
      "from typing import Annotated",
      "from rich.console import Console",
      "from rich.table import Table",
      "import typer",
      "",
      "console = Console()",
      "app = typer.Typer(",
      "    name=\"${1:tool-name}\",",
      "    help=\"${2:Tool description.}\",",
      "    no_args_is_help=True,",
      ")",
      "",
      "",
      "@app.command()",
      "def ${3:run}(",
      "    ${4:target}: Annotated[str, typer.Argument(help=\"${5:Target argument}\")],",
      "    ${6:debug}: Annotated[bool, typer.Option(\"--debug\", \"-d\", help=\"Enable debug output\")] = False,",
      ") -> None:",
      "    \"\"\"${7:Command description.}\"\"\"",
      "    console.print(f\"[bold green]Executing:[/bold green] {${4:target}}\")",
      "    ${0}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    app()"
    ],
    "description": "PEP 723 standalone CLI using modern Typer Annotated syntax and Rich"
  },
  "PEP 723 Rich Table + Argparse": {
    "prefix": "pep723-rich",
    "body": [
      "#!/usr/bin/env -S uv run --script",
      "# /// script",
      "# requires-python = \">=3.12\"",
      "# dependencies = [",
      "#     \"rich\",",
      "#     \"${1:requests}\",",
      "# ]",
      "# bin-name = \"${2:tool-name}\"",
      "# ///",
      "from __future__ import annotations",
      "",
      "import argparse",
      "import sys",
      "from rich.console import Console",
      "from rich.table import Table",
      "",
      "console = Console()",
      "",
      "",
      "def parse_args() -> argparse.Namespace:",
      "    parser = argparse.ArgumentParser(description=\"${3:Script description}\")",
      "    parser.add_argument(\"${4:target}\", help=\"${5:Target argument}\")",
      "    parser.add_argument(\"--format\", choices=[\"text\", \"json\", \"compact\"], default=\"text\")",
      "    return parser.parse_args()",
      "",
      "",
      "def main() -> int:",
      "    args = parse_args()",
      "    table = Table(title=\"${6:Results}\")",
      "    table.add_column(\"Key\", style=\"cyan\")",
      "    table.add_column(\"Value\", style=\"green\")",
      "    table.add_row(\"${4:target}\", str(args.${4:target}))",
      "    console.print(table)",
      "    ${0}",
      "    return 0",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    sys.exit(main())"
    ],
    "description": "PEP 723 script with Argparse and formatted Rich Table output"
  },
  "Dataclass Model": {
    "prefix": "dataclass",
    "body": [
      "@dataclass",
      "class ${1:ModelName}:",
      "    \"\"\"${2:Model description.}\"\"\"",
      "    ${3:name}: str",
      "    ${4:value}: int",
      "    ${0}"
    ],
    "description": "Standard typed dataclass definition"
  },
  "XDG Data Directory Resolver": {
    "prefix": "xdg-dir",
    "body": [
      "def get_${1:data}_dir() -> Path:",
      "    \"\"\"Return the application ${1:data} directory (respects XDG).\"\"\"",
      "    env_override = os.environ.get(\"${2:APP}_${1/(.*)/${1:/upcase}/}_DIR\")",
      "    if env_override:",
      "        return Path(env_override).expanduser()",
      "    xdg = os.environ.get(\"XDG_${1/(.*)/${1:/upcase}/}_HOME\")",
      "    if xdg:",
      "        return Path(xdg) / \"${3:app-name}\"",
      "    return Path.home() / \".${1:local/share}\" / \"${3:app-name}\"${0}"
    ],
    "description": "Resolve application directory following XDG base directory specification"
  },
  "Human-Readable Size Formatter": {
    "prefix": "human-readable",
    "body": [
      "def human_readable_bytes(num_bytes: int | float) -> str:",
      "    \"\"\"Convert bytes to a human-friendly string (e.g. 12.4 MB).\"\"\"",
      "    units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\"]",
      "    size = float(num_bytes)",
      "    for unit in units:",
      "        if size < 1024 or unit == units[-1]:",
      "            return f\"{size:.1f} {unit}\"",
      "        size /= 1024",
      "    return f\"{size:.1f} PB\"${0}"
    ],
    "description": "Human-readable byte size formatting utility"
  },
  "Rich Table Builder": {
    "prefix": "rich-table",
    "body": [
      "table = Table(title=\"${1:Title}\")",
      "table.add_column(\"${2:Col1}\", style=\"${3:cyan}\")",
      "table.add_column(\"${4:Col2}\", style=\"${5:green}\")",
      "table.add_row(\"${6:Val1}\", \"${7:Val2}\")",
      "console.print(table)${0}"
    ],
    "description": "Construct and print a Rich Table"
  }
}
