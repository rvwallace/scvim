{
  "CLI Subcommand Dispatcher": {
    "prefix": "cli-subcommands",
    "body": [
      "package main",
      "",
      "import (",
      "\t\"flag\"",
      "\t\"fmt\"",
      "\t\"os\"",
      ")",
      "",
      "func main() {",
      "\tif len(os.Args) < 2 {",
      "\t\tprintUsage()",
      "\t\tos.Exit(1)",
      "\t}",
      "",
      "\tswitch os.Args[1] {",
      "\tcase \"${1:run}\":",
      "\t\trun${1/(.*)/${1:/capitalize}/}(os.Args[2:])",
      "\tcase \"--help\", \"-h\", \"help\":",
      "\t\tprintUsage()",
      "\tdefault:",
      "\t\tfmt.Fprintf(os.Stderr, \"unknown command %q\\n\\n\", os.Args[1])",
      "\t\tprintUsage()",
      "\t\tos.Exit(1)",
      "\t}",
      "}",
      "",
      "func printUsage() {",
      "\tfmt.Fprint(os.Stderr, `Usage: ${2:tool} <command> [flags]",
      "",
      "Commands:",
      "  ${1:run}        ${3:Description}",
      "`)",
      "}",
      "",
      "func run${1/(.*)/${1:/capitalize}/}(args []string) {",
      "\tfs := flag.NewFlagSet(\"${1:run}\", flag.ExitOnError)",
      "\t${0}",
      "\t_ = fs.Parse(args)",
      "}"
    ],
    "description": "Go CLI application with subcommand dispatching and flag sets"
  },
  "Bubble Tea App Boilerplate": {
    "prefix": "bubbletea",
    "body": [
      "package main",
      "",
      "import (",
      "\t\"fmt\"",
      "\t\"os\"",
      "",
      "\ttea \"charm.land/bubbletea/v2\"",
      ")",
      "",
      "type model struct {",
      "\t${1:choice string}",
      "}",
      "",
      "func newModel() model {",
      "\treturn model{}",
      "}",
      "",
      "func (m model) Init() (tea.Model, tea.Cmd) {",
      "\treturn m, nil",
      "}",
      "",
      "func (m model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {",
      "\tswitch msg := msg.(type) {",
      "\tcase tea.KeyMsg:",
      "\t\tswitch msg.String() {",
      "\t\tcase \"q\", \"ctrl+c\":",
      "\t\t\treturn m, tea.Quit",
      "\t\t}",
      "\t}",
      "\treturn m, nil",
      "}",
      "",
      "func (m model) View() string {",
      "\treturn \"${2:Hello, Bubble Tea!}\\n\\nPress q to quit.\\n\"",
      "}",
      "",
      "func main() {",
      "\tp := tea.NewProgram(newModel(), tea.WithAltScreen())",
      "\tif _, err := p.Run(); err != nil {",
      "\t\tfmt.Fprintf(os.Stderr, \"error: %v\\n\", err)",
      "\t\tos.Exit(1)",
      "\t}",
      "}"
    ],
    "description": "Bubble Tea v2 interactive terminal application template"
  },
  "If Error Wrap": {
    "prefix": "ifew",
    "body": [
      "if err != nil {",
      "\treturn fmt.Errorf(\"${1:context}: %w\", err)",
      "}${0}"
    ],
    "description": "If error return wrapped error"
  }
}
