{
  "Bash Script Boilerplate (Toolbox Style)": {
    "prefix": ["script", "sh-script", "bash-script", "boilerplate"],
    "body": [
      "#!/usr/bin/env bash",
      "# shellcheck shell=bash",
      "set -euo pipefail",
      "",
      "readonly SCRIPT_DIR=\"\\$(cd \"\\$(dirname \"\\${BASH_SOURCE[0]}\")\" && pwd)\"",
      "readonly PROGNAME=\"\\$(basename \"\\$0\")\"",
      "",
      "die() {",
      "    echo \"\\${PROGNAME}: \\$*\" >&2",
      "    exit 1",
      "}",
      "",
      "require_command() {",
      "    command -v \"\\$1\" >/dev/null 2>&1 || die \"required command not found: \\$1\"",
      "}",
      "",
      "usage() {",
      "    cat <<'USAGE_EOF'",
      "Usage:",
      "  \\${PROGNAME} [options] <arguments>",
      "",
      "Options:",
      "  -h, --help    Show this help message",
      "USAGE_EOF",
      "}",
      "",
      "main() {",
      "    ${0:# your code here}",
      "}",
      "",
      "main \"\\$@\""
    ],
    "description": "Production-grade Bash boilerplate with strict mode, die, require_command, and usage"
  },
  "Zsh Autoload Function": {
    "prefix": "zsh-function",
    "body": [
      "#autoload",
      "# ${1:Function description}",
      "",
      "emulate -L zsh",
      "",
      "if (( \\$# == 0 )); then",
      "    echo \"Usage: ${2:func_name} <arguments>\" >&2",
      "    return 1",
      "fi",
      "",
      "${0}"
    ],
    "description": "Zsh autoload function boilerplate with emulate -L and argument check"
  },
  "Die Helper": {
    "prefix": "die",
    "body": [
      "die() {",
      "    echo \"${1:error}: \\$*\" >&2",
      "    exit 1",
      "}"
    ],
    "description": "Die error exit function"
  },
  "Require Command": {
    "prefix": "require-cmd",
    "body": [
      "require_command() {",
      "    command -v \"\\$1\" >/dev/null 2>&1 || die \"required command not found: \\$1\"",
      "}"
    ],
    "description": "Ensure required binary exists on PATH"
  },
  "Safe Temporary File with Trap": {
    "prefix": "tmpfile",
    "body": [
      "tmp_file=\"\\$(mktemp \"\\${TMPDIR:-/tmp}/${1:script}.XXXXXX\")\"",
      "trap 'rm -f \"\\${tmp_file:-}\"' EXIT",
      "${0}"
    ],
    "description": "Create a temporary file with automatic EXIT cleanup trap"
  },
  "Argument Parser (while/case)": {
    "prefix": "parse-args",
    "body": [
      "while [[ \\$# -gt 0 ]]; do",
      "    case \"\\$1\" in",
      "        -${1:h}|--${2:help})",
      "            usage",
      "            exit 0",
      "            ;;",
      "        -${3:f}|--${4:file})",
      "            ${5:FILE}=\"\\$2\"",
      "            shift 2",
      "            ;;",
      "        --) shift; break ;;",
      "        *)",
      "            die \"unknown option: \\$1\"",
      "            ;;",
      "    esac",
      "done",
      "${0}"
    ],
    "description": "Standard CLI argument parser loop with while, case, and double-dash"
  },
  "XDG Base Directory Constants": {
    "prefix": "xdg-dirs",
    "body": [
      "readonly CONFIG_DIR=\"\\${XDG_CONFIG_HOME:-\\${HOME}/.config}/${1:app}\"",
      "readonly DATA_DIR=\"\\${XDG_DATA_HOME:-\\${HOME}/.local/share}/${1:app}\"",
      "readonly STATE_DIR=\"\\${XDG_STATE_HOME:-\\${HOME}/.local/state}/${1:app}\"",
      "readonly CACHE_DIR=\"\\${XDG_CACHE_HOME:-\\${HOME}/.cache}/${1:app}\""
    ],
    "description": "XDG base directory specification constants with fallbacks"
  },
  "ANSI Terminal Colors": {
    "prefix": "colors",
    "body": [
      "readonly RED=$'\\033[31m'",
      "readonly GREEN=$'\\033[32m'",
      "readonly YELLOW=$'\\033[33m'",
      "readonly BLUE=$'\\033[34m'",
      "readonly BOLD=$'\\033[1m'",
      "readonly RESET=$'\\033[0m'"
    ],
    "description": "ANSI color code constants for shell scripts"
  }
}
